# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Same-origin site assets, plus the host-injected Cloudflare Web Analytics beacon.
# Cloudflare automatic setup reports to same-origin /cdn-cgi/rum; manual setup uses
# cloudflareinsights.com. Neither needs inline execution or eval.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; worker-src 'none'; frame-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate
